  "tweaks": {
    "telemetryMinimum":        { "enabled": true,  "why": "AllowTelemetry policy at the lowest level the edition accepts (0 = Enterprise/Education only; Pro floors at 1)" },
    "disableCopilotAndRecall": { "enabled": true,  "why": "Policies that switch off Windows Copilot and Recall snapshots" },
    "disableConsumerFeatures": { "enabled": true,  "why": "Stops auto-installed suggested apps (honoured fully on Enterprise/Education)" },
    "disableAdvertisingId":    { "enabled": true,  "why": "Per-user ad tracking ID" },
    "disableLLMNR":            { "enabled": true,  "why": "Multicast name resolution; poisoning target (Responder)" },
    "disableNetbiosOverTcp":   { "enabled": true,  "why": "NetBIOS name service on every adapter" },
    "requireSmbSigning":       { "enabled": true,  "why": "Blocks SMB relay" },
    "disableAutorun":          { "enabled": true,  "why": "No autorun from any drive, including the Z: shared folder" },
    "disableWDigest":          { "enabled": true,  "why": "No cleartext credentials in LSASS memory" },
    "lsaProtection":           { "enabled": true,  "why": "Runs LSASS as a protected process (RunAsPPL)" },
    "defenderPua":             { "enabled": true,  "why": "Defender blocks potentially unwanted apps" },
    "rdpRequireNla":           { "enabled": true,  "why": "RDP needs Network Level Authentication (Guacamole supports it)" },
    "rdpDisableDriveRedirect": { "enabled": true,  "why": "Clients can't map their drives into the VM" },
    "rdpDisableClipboard":     { "enabled": false, "why": "Blocks copy/paste through Guacamole. Set true for the strictest isolation" },
    "disableWindowsUpdate":    { "enabled": false, "why": "Leave false and allowlist the update domains in egress unless you rebuild VMs often from fresh images" }
  },

  "proxy": {
    "enabled": true,
    "server": "172.31.0.2:3128",
    "bypass": "<local>",
    "why": "Points WinHTTP and system (Edge/WinINet) traffic at the egress proxy. Set server to this VM's egress IP; make-oem.sh does that for you"
  },

  "firewall": {
    "defaultInbound": "Block",
    "rdpAllowFrom": "Any",
    "why": "Inbound is blocked except RDP. dockur NATs the port, so the source Windows sees may be the container gateway rather than guacd; tighten rdpAllowFrom only after checking the RDP rule's hits"
  },

  "installers": [
    { "file": "installers/vc_redist.x64.exe", "args": "/install /quiet /norestart", "install": true,  "why": "Visual C++ 2015-2022 runtime; most desktop apps need it" },
    { "file": "installers/PowerShell-x64.msi", "args": "/qn /norestart ADD_PATH=1 ENABLE_PSREMOTING=0", "install": false, "why": "PowerShell 7" },
    { "file": "installers/Git-64-bit.exe",     "args": "/VERYSILENT /NORESTART /NOCANCEL /SP-",   "install": false, "why": "Git for Windows" },
    { "file": "installers/node-x64.msi",       "args": "/qn /norestart",                          "install": false, "why": "Node.js LTS" },
    { "file": "installers/7z-x64.exe",         "args": "/S",                                      "install": false, "why": "7-Zip" }
  ]
